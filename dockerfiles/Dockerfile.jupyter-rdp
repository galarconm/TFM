# Dockerfile para JupyterLab Desktop con soporte RDP
# funciona bien, nada de mensajes de error
FROM python:3.9-slim

# Evitar advertencias cambiando a no interactivo durante el proceso de construcción
ENV DEBIAN_FRONTEND=noninteractive

# Instalar dependencias
RUN apt-get update && \
    apt-get install -y \
    build-essential \
    xvfb \
    xrdp \
    xfce4 \
    dbus-x11 \
    firefox-esr \
    git \
    xterm \
    && apt-get clean && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*
    
# Instalar JupyterLab
RUN pip3 install jupyterlab

# Configurar xfce4 como el entorno de escritorio para xrdp
RUN echo xfce4-session > /root/.xsession

# Crear una cuenta de usuario
RUN useradd -m myuser && echo "myuser:mypassword" | chpasswd

# Exponer puertos para RDP (3389)
EXPOSE 3389

# Copiar script de inicio
COPY start_rdp.sh /usr/local/bin/start_rdp.sh
RUN chmod +x /usr/local/bin/start_rdp.sh

# Copiar script add_users.sh
COPY add_users.sh /usr/local/bin/add_users.sh
RUN chmod +x /usr/local/bin/add_users.sh

# Comando para iniciar xrdp y JupyterLab Desktop
CMD service xrdp start && /usr/local/bin/start_rdp.sh