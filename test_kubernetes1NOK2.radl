network publica (outbound = 'yes')
network privada ()

system front (
cpu.arch='x86_64' and
cpu.count>=6 and
memory.size>=6g and
net_interface.0.connection = 'privada' and
net_interface.0.dns_name = 'kubeserver' and
net_interface.1.connection = 'publica' and
net_interface.1.dns_name = 'kubeserverpublic' and
disk.0.os.name='linux' and
disk.0.os.flavour='ubuntu' and
disk.0.image.url = 'one://ramses.i3m.upv.es/1593' and
disk.0.applications contains (name='ansible.roles.grycap.kubernetes') and
disk.0.applications contains (name='ansible.roles.grycap.nfs')
)

system wn (
cpu.arch='x86_64' and
cpu.count>=6 and
memory.size>=6g and
net_interface.0.connection = 'privada' and
net_interface.0.dns_name = 'wn-#N#' and
disk.0.os.name='linux' and
disk.0.os.flavour='ubuntu' and
disk.0.image.url = 'one://ramses.i3m.upv.es/1593'
)



configure front (
@begin
---
 - pre_tasks:
    - name: Create dir for the NFS PV
      file: path=/var/nfs_share state=directory mode=777
    - name: Set ownership for NFS PV  
      command: chown -R nobody:nogroup /var/nfs_share
    
    - name: Create dir for the NFS PV mysql
      file: path=/var/nfs_share/mysql state=directory mode=777
    - name: Set ownership for NFS PV  mysql
      command: chown -R nobody:nogroup /var/nfs_share/mysql
    
    - name: Create dir for the NFS PV postgres
      file: path=/var/nfs_share/postgres state=directory mode=750
    - name: Set ownership for NFS PV  postgres
      command: chown -R nobody:nogroup /var/nfs_share/postgres

    - name: Create dir for the NFS PV jenkins
      file: path=/var/nfs_share/jenkins state=directory mode=777
    - name: Set ownership for NFS PV jenkins
      command: chown -R nobody:nogroup /var/nfs_share/jenkins

    - name: Create dir for the NFS PV home
      file: path=/var/nfs_share/home state=directory mode=777
    - name: Set ownership for NFS PV  home
      command: chown -R nobody:nogroup /var/nfs_share/home

    - name: Create auth file dir
      file: 
        path: /etc/kubernetes/pki 
        state: directory 
        mode: 755 
        recurse: yes
    - name: Create auth data file with an admin user
      copy: 
        content: 'sometoken,kubeuser,100,"users,system:masters"' 
        dest: /etc/kubernetes/pki/auth 
        mode: 600
    - name: Set KUBECONFIG environment variable
      lineinfile:
        path: /etc/environment
        line: 'KUBECONFIG=/etc/kubernetes/admin.conf'
        create: yes
    - name: Install Project from Github
      git:
        repo: https://github.com/galarconm/TFM
        dest: ~/projects/
        version: main
    - name: Make deploy-all.sh executable
      file:
        path: ~/projects/deploy-resources.sh
        mode: '0755'

   roles:
    - role: 'grycap.nfs'
      nfs_mode: 'front'
      nfs_exports: 
        - path: "/var/nfs_share"
          export: "wn-*.localdomain(fsid=0,rw,async,no_root_squash,no_subtree_check,insecure)"
        - path: "/var/nfs_share/mysql"
          export: "wn-*.localdomain(rw,sync,no_subtree_check)"
        - path: "/var/nfs_share/postgres"
          export: "wn-*.localdomain(rw,sync,no_subtree_check,no_root_squash)"
        - path: "/var/nfs_share/jenkins" 
          export: "wn-*.localdomain(rw,sync,no_subtree_check)"
        - path: "/var/nfs_share/home"
          export: "wn-*.localdomain(rw,sync,no_subtree_check,no_root_squash)"

    - role: 'grycap.kubernetes'
      kube_server: 'kubeserver'
      kube_version: 1.30.8
      kube_apiserver_options: []
      kube_deploy_dashboard: true
      kube_install_helm: true

 - tasks:
    - name: Wait for Kubernetes worker nodes to be ready
      shell: |
        until kubectl get nodes -o jsonpath='{.items[?(@.metadata.name=~"wn-.*")].status.conditions[?(@.type=="Ready")].status}' | grep -q "True"; do
          sleep 5
        done
      register: kube_ready
      retries: 30
      delay: 10
      ignore_errors: yes

    - name: Ensure deploy-resources.sh exists and is executable
      stat:
        path: ~/projects/deploy-resources.sh
      register: deploy_script

    - name: Fail if deploy-resources.sh does not exist
      fail:
        msg: "deploy-resources.sh does not exist in ~/projects/."
      when: not deploy_script.stat.exists

    - name: Ensure deploy-resources.sh is executable
      file:
        path: ~/projects/deploy-resources.sh
        mode: '0755'

    - name: Deploy infrastructure 
      command: ./deploy-resources.sh
      args:
        chdir: ~/projects/
      register: deploy_output

    - name: Show deploy-resources output
      debug:
        var: deploy_output.stdout

@end
)

configure wn (
@begin
---
 - roles:
    - role: 'grycap.nfs'
      nfs_mode: 'wn'

    - role: 'grycap.kubernetes'
      kube_version: 1.30.8
      kube_type_of_node: 'wn'
      kube_server: 'kubeserver'

@end
)

deploy front 1
deploy wn 2